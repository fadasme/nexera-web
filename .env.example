# ── Generado normalmente por `npm run setup`; este archivo es la referencia. ──

# Destino de deploy: node (VPS + MySQL) | cloudflare (Workers + D1)
DEPLOY_TARGET=node

# ── Sitio (PUBLIC_ = se inlinea en build; visible en el cliente; jamás secretos) ──
PUBLIC_SITE_URL=https://nexera.cl
PUBLIC_SITE_NAME=Nexera
PUBLIC_BUSINESS_EMAIL=contacto@nexera.cl
PUBLIC_BUSINESS_PHONE=+56 9 5400 9251
PUBLIC_BUSINESS_WHATSAPP=56954009251
PUBLIC_BUSINESS_STREET=
PUBLIC_BUSINESS_CITY=Santiago
PUBLIC_BUSINESS_REGION=Región Metropolitana
PUBLIC_BUSINESS_COUNTRY=CL
# separadas por coma: https://linkedin.com/company/...,https://github.com/...
PUBLIC_BUSINESS_SOCIAL=

# ── Analítica: ga4 | umami | plausible | cloudflare | none ──
PUBLIC_ANALYTICS_PROVIDER=none
PUBLIC_ANALYTICS_ID=
# solo umami/plausible self-hosted (URL del script)
PUBLIC_ANALYTICS_SRC=

# ── Captcha: turnstile | recaptcha | none ──
PUBLIC_CAPTCHA_PROVIDER=none
PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# ── Anti-spam ──
# generado por setup si falta (hex aleatorio)
IP_HASH_SALT=
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=3600

# ── Base de datos (solo target node) ──
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nexera
MYSQL_PASSWORD=
MYSQL_DATABASE=nexera

# ── Correo: resend | smtp (solo node) | none ──
MAIL_PROVIDER=none
RESEND_API_KEY=
MAIL_FROM=Nexera <no-reply@nexera.cl>
MAIL_TO=contacto@nexera.cl
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ── Runtime node (systemd) ──
HOST=127.0.0.1
PORT=4321
