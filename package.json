{
  "name": "nexera-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:cf": "DEPLOY_TARGET=cloudflare astro dev",
    "build": "astro build",
    "build:node": "DEPLOY_TARGET=node astro build",
    "build:cf": "DEPLOY_TARGET=cloudflare astro build",
    "check": "astro sync && node scripts/check-astro.mjs && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "preview": "astro preview",
    "setup": "node scripts/setup.mjs",
    "migrate:php": "node scripts/migrate-php.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/node": "^11.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/archivo": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "astro": "^7.1.6",
    "mysql2": "^3.14.0",
    "nodemailer": "^9.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.16.13",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.116.0"
  },
  "overrides": {
    "@volar/kit": {
      "typescript": "6.0.3"
    }
  },
  "allowScripts": {
    "workerd@1.20260730.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.2": true,
    "sharp@0.35.3": true
  }
}
