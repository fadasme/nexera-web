---
/**
 * Analítica intercambiable por PUBLIC_ANALYTICS_PROVIDER.
 * Proveedor nuevo = un caso aquí + un caso en src/scripts/track.ts.
 */
const provider = import.meta.env.PUBLIC_ANALYTICS_PROVIDER ?? 'none';
const id = import.meta.env.PUBLIC_ANALYTICS_ID ?? '';
const src = import.meta.env.PUBLIC_ANALYTICS_SRC ?? '';

const umamiSrc = src || 'https://cloud.umami.is/script.js';
const plausibleSrc = src || 'https://plausible.io/js/script.js';
const cfBeacon = JSON.stringify({ token: id });
---

{
  provider === 'ga4' && id && (
    <>
      <script is:inline defer src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', id);
      </script>
    </>
  )
}
{provider === 'umami' && id && <script is:inline defer src={umamiSrc} data-website-id={id} />}
{provider === 'plausible' && id && <script is:inline defer data-domain={id} src={plausibleSrc} />}
{
  provider === 'cloudflare' && id && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={cfBeacon}
    />
  )
}
