---
import { SERVICIOS_TABS } from '@/config/contenido';
---

<section id="servicios" class="servicios-wrap">
  <div class="container servicios">
    <div class="head">
      <div>
        <p class="eyebrow">Servicios</p>
        <h2>Servicios principales para empresas que quieren avanzar con tecnología real.</h2>
      </div>
      <span class="hint" aria-hidden="true">↑ pasa el cursor por la lista</span>
    </div>

    <div class="grid" data-tabs>
      <div class="tabs" role="tablist" aria-label="Servicios">
        {
          SERVICIOS_TABS.map((s, i) => (
            <button
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              class={`tab ${i === 0 ? 'active' : ''}`}
              data-tab-btn={i}
            >
              <span class="num">{s.num}</span>
              <span class="t">{s.title}</span>
            </button>
          ))
        }
      </div>

      <div class="panels">
        {
          SERVICIOS_TABS.map((s, i) => (
            <article class={`panel ${i === 0 ? 'active' : ''}`} data-tab-panel={i}>
              <h3>{s.title}</h3>
              <p class="desc">{s.desc}</p>
              <div class="dash-line divisor" aria-hidden="true" />
              <div class="chips">
                {s.chips.map((chip) => (
                  <span class="chip">{chip}</span>
                ))}
              </div>
              <a href="#contacto" class="btn-line panel-cta">
                Conversemos <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .servicios-wrap {
    background: var(--bg-alt);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .servicios {
    padding-top: 84px;
    padding-bottom: 84px;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 40px;
  }

  .head .eyebrow {
    margin: 0 0 16px;
  }

  h2 {
    margin: 0;
    font: 800 38px/1.06 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--text-hi);
    max-width: 24em;
    text-wrap: pretty;
  }

  .hint {
    flex: none;
    font: 400 12px/1.5 var(--font-mono);
    color: var(--text-mute);
  }

  .grid {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 40px;
    align-items: stretch;
  }

  .tabs {
    display: flex;
    flex-direction: column;
  }

  .tab {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 19px 20px;
    background: transparent;
    border: 0;
    border-left: 2px solid rgba(255, 255, 255, 0.09);
    cursor: pointer;
    text-align: left;
    transition: all 0.3s;
  }

  .tab:hover {
    border-left-color: rgba(69, 199, 255, 0.5);
  }

  .tab .num {
    font: 500 11px/1 var(--font-mono);
    color: var(--text-mute);
  }

  .tab .t {
    font: 600 16px/1.3 var(--font-display);
    color: var(--text-dim);
  }

  .tab.active {
    background: rgba(69, 199, 255, 0.1);
    border-left-color: var(--accent);
  }

  .tab.active .num {
    color: var(--accent);
  }

  .tab.active .t {
    font-weight: 700;
    color: var(--text-hi);
  }

  .panels {
    display: flex;
    flex-direction: column;
  }

  .panel {
    display: none;
    flex: 1;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: var(--bg);
    padding: 38px 36px;
  }

  .panel.active {
    display: flex;
    animation: fadein 0.4s both;
  }

  /* Sin JS: los 5 paneles quedan visibles. */
  :global(html.no-js) .panel {
    display: flex;
  }

  :global(html.no-js) .panel + .panel {
    margin-top: 16px;
  }

  h3 {
    margin: 0 0 14px;
    font: 700 29px/1.15 var(--font-display);
    letter-spacing: -0.025em;
    color: var(--text-hi);
  }

  .desc {
    margin: 0 0 28px;
    font: 400 16.5px/1.65 var(--font-sans);
    color: var(--text-body);
    max-width: 44em;
    text-wrap: pretty;
  }

  .divisor {
    background-image: repeating-linear-gradient(
      90deg,
      rgba(69, 199, 255, 0.5) 0 5px,
      transparent 5px 12px
    );
    background-size: 12px 1px;
  }

  .chips {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .chip {
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 9px 14px;
    border-radius: 2px;
    font: 400 12px/1 var(--font-mono);
    color: var(--text-dim);
  }

  .panel-cta {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 15px;
  }

  .chips + .panel-cta {
    margin-top: 28px;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .hint {
      display: none;
    }

    h2 {
      font-size: 30px;
    }
  }

  @media (max-width: 640px) {
    .servicios {
      padding-top: 56px;
      padding-bottom: 56px;
    }

    h2 {
      font-size: 26px;
    }

    .panel {
      padding: 26px 22px;
    }
  }
</style>
